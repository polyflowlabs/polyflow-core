{
  "schema_version": 1,
  "name": "polyflow_sensors",
  "drivers": [
    {
      "name": "bno085_imu",
      "class": "polyflow_sensors_adapter.bno085:Bno085ImuAdapter",
      "iotype_compat": ["imu"],
      "parameters": {
        "i2c_address": {"label": "I2C Address", "description": "0x4A (default) or 0x4B with ADR pulled high.", "type": "number", "default": 74},
        "rate_hz": {"label": "Report Rate (Hz)", "type": "number", "default": 100, "min": 1}
      }
    },
    {
      "name": "gpio_contact",
      "class": "polyflow_sensors_adapter.contact:GpioContactAdapter",
      "iotype_compat": ["contact"],
      "parameters": {
        "gpio": {"label": "GPIO (BCM)", "description": "The switch closes to ground; the pin is pulled up.", "type": "number", "required": true},
        "rate_hz": {"label": "Report Rate (Hz)", "type": "number", "default": 200, "min": 1}
      }
    },
    {
      "name": "vl53l1x_range",
      "class": "polyflow_sensors_adapter.vl53l1x:Vl53l1xRangeAdapter",
      "iotype_compat": ["range"],
      "parameters": {
        "i2c_address": {"label": "I2C Address", "type": "number", "default": 41},
        "rate_hz": {"label": "Report Rate (Hz)", "type": "number", "default": 50, "min": 1},
        "distance_mode": {"label": "Distance Mode", "description": "1 = short (to 1.3 m, better in sunlight), 2 = long (to 4 m).", "type": "number", "default": 2}
      }
    }
  ]
}
